NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=your-instance-id
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=your-instance-id
AURA_INSTANCEID=your-instance-id
AURA_INSTANCENAME=CareerGraph

# --- LLM (Groq) -------------------------------------------------------------------------
# Server-side only. NEVER put the key in frontend code, a committed file, or a chat message.
# LLM_PROVIDER=groq  -> requirement extraction + CV writing via the Groq API (needs GROQ_API_KEY)
# LLM_PROVIDER=dev   -> explicit development fallback: heuristic extraction + rule-based CV
#                       writer (no API key, no network; labelled as fallback in the UI)
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_EXTRACTION_MODEL=openai/gpt-oss-120b
LLM_WRITING_MODEL=openai/gpt-oss-120b
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Optional (defaults shown)
# LLM_STRICT_SCHEMA=true                 # Groq strict structured-output mode
# LLM_MAX_JOB_DESCRIPTION_CHARS=20000
# LLM_MAX_CV_CONTEXT_CHARS=60000
# LLM_MAX_SOURCE_CV_CHARS=40000          # longest CV text sent to the model for parsing

# --- Source CV (private storage) ----------------------------------------------------------
# The uploaded original and its parsed profile are stored on THIS server, under a gitignored
# directory. Default: <repo>/data/private. Never commit anything from here.
# CAREERGRAPH_PRIVATE_DIR=

